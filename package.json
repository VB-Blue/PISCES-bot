{
  "name": "pisces-ai",
  "productName": "PISCES AI",
  "version": "0.23.0",
  "private": true,
  "description": "AI 正常工作，核心从真实经验中成长的桌面工作台",
  "author": "PISCES AI",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "desktop": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir --win --x64",
    "smoke": "electron . --smoke",
    "smoke:ui": "electron . --ui-smoke",
    "smoke:core": "node scripts/smoke-core.cjs",
    "smoke:memory-core": "node scripts/smoke-memory-core.cjs",
    "smoke:cognition": "node scripts/smoke-cognition.cjs",
    "smoke:media": "electron scripts/smoke-media.cjs",
    "pack:core": "npm run build && electron-builder --dir --win --x64 --config.directories.output=\"release/pisces-ai-v0.23.0\"",
    "smoke:concurrency": "node scripts/smoke-concurrency.cjs",
    "test": "node --test tests/*.test.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "smoke:assistant": "node scripts/smoke-assistant.cjs",
    "smoke:desktop": "node scripts/smoke-desktop.cjs",
    "smoke:continuity": "node scripts/smoke-continuity.cjs",
    "eval": "electron electron/eval-real.cjs",
    "brand:icons": "electron scripts/build-brand-icons.cjs",
    "smoke:workspaces": "node scripts/smoke-workspaces.cjs",
    "smoke:task": "node scripts/smoke-task.cjs",
    "smoke:host": "node scripts/smoke-host.cjs",
    "smoke:parallel": "node scripts/smoke-parallel.cjs",
    "smoke:goals": "node scripts/smoke-goals.cjs",
    "smoke:browser": "node scripts/smoke-browser.cjs",
    "smoke:browser-engine": "node scripts/smoke-browser-engine.cjs",
    "smoke:requirements": "node scripts/smoke-requirements.cjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "pdfjs-dist": "^6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.3",
    "vite": "8.3.1"
  },
  "build": {
    "appId": "local.pisces.ai.fingerprint.taskbar",
    "productName": "PISCES AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack-brand.cjs",
    "extraResources": [
      {
        "from": "electron/desktop-lifecycle.ps1",
        "to": "desktop-lifecycle.ps1"
      },
      {
        "from": "public/fingerprint-transparent.ico",
        "to": "pisces-fingerprint-transparent.ico"
      },
      {
        "from": "public/fingerprint-transparent-dark.ico",
        "to": "pisces-fingerprint-transparent-dark.ico"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "dir",
      "icon": "public/icon.ico",
      "signExecutable": false
    }
  }
}
